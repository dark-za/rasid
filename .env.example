# انسخ هذا الملف إلى .env في جذر المشروع (بجانب docker-compose.yml)
# compose يقرأ .env تلقائياً لاستبدال المتغيّرات، والباكند يقرأه أيضاً عند التشغيل المحلي
# لتوليد مفتاح API: python -c "import secrets;print(secrets.token_urlsafe(32))"

DB_USER=root
DB_HOST=127.0.0.1
DB_PORT=3306

# قاعدة بيانات نظام راصد (تُنشأ تلقائياً إن لم تكن موجودة)
APP_DB_NAME=rasid_db

# قاعدة بيانات البصمة SmartPSS (قراءة فقط)
ATTENDANCE_DB_NAME=smartpss_local

# --- تشفير كلمة سر قاعدة البيانات (موصى به بدل DB_PASS الصريح) ---
# 1) ولّد المفتاح:  python -m security genkey
# 2) ولّد الشيفرة:  RASID_SECRETS_KEY=<المفتاح> python -m security encrypt 'كلمة-السر'
# في الإنتاج ضع RASID_SECRETS_KEY عبر متغيّر بيئة/Vault وليس في الملف
RASID_SECRETS_KEY=
DB_PASS_ENC=
# بديل للتطوير المحلي فقط:
# DB_PASS=

# مفتاح واجهة API (توليد: python -c "import secrets;print(secrets.token_urlsafe(32))")
RASID_API_KEY=

CORS_ORIGINS=http://localhost:3005,http://127.0.0.1:3005

# منطقة التوقيت ونمط فهم توقيت البصمة (تحقق من ATTENDANCE_EPOCH_IS_LOCAL قبل التغيير)
APP_TIMEZONE=Asia/Riyadh
ATTENDANCE_EPOCH_IS_LOCAL=true

DEBOUNCE_MINUTES=5
DEFAULT_SHIFT_START=08:00
DEFAULT_GRACE_MINUTES=15
