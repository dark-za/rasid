# انسخ هذا الملف إلى .env في جذر المشروع (بجانب docker-compose.yml)
# قاعدة راصد محلية في SQLite. لا يلزم إعداد قاعدة بيانات أو مستخدم لها.
# اتصال القراءة فقط بقاعدة بصمات SmartPSS الخارجية.
DB_HOST=192.168.8.3
DB_PORT=3306
ATTENDANCE_DB_USER=rasid_reader
ATTENDANCE_DB_NAME=smartpss_local
ATTENDANCE_PASS=

# حساب المشرف الوحيد؛ اسم المستخدم الافتراضي admin، اختر كلمة مرور قوية ولا تشاركها
RASID_LOGIN_USERNAME=admin
RASID_LOGIN_PASSWORD=
# سر توقيع جلسات المشرف
RASID_SESSION_SECRET=

CORS_ORIGINS=http://localhost:3005,http://127.0.0.1:3005

# منطقة التوقيت ونمط فهم توقيت البصمة (تحقق من ATTENDANCE_EPOCH_IS_LOCAL قبل التغيير)
APP_TIMEZONE=Asia/Riyadh
ATTENDANCE_EPOCH_IS_LOCAL=true

DEBOUNCE_MINUTES=5
DEFAULT_SHIFT_START=08:00
DEFAULT_GRACE_MINUTES=15
